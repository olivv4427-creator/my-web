<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>수해나에서 살아남기</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        body {
            font-family: 'Pretendard', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            background-color: #0b0f17;
        }
        .phone-frame {
            width: 100%;
            max-width: 430px;
            margin: 0 auto;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .canvas-container {
            position: relative;
            width: 100%;
            aspect-ratio: 4 / 3;
            margin: 0 auto;
        }
        .touch-active:active {
            transform: scale(0.96);
            filter: brightness(1.1);
        }
    </style>
</head>
<body class="text-white flex items-center justify-center p-0 md:p-4">

    <!-- 메인 프레임 -->
    <div class="phone-frame bg-slate-900 border-x border-slate-800 shadow-2xl p-4 flex flex-col">

        <!-- 메인 화면 -->
        <div id="screen-main" class="flex-1 flex flex-col justify-between items-center py-6 text-center">
            <div class="w-full flex flex-col items-center space-y-4 my-auto">
                <!-- 수해나 로고 (SVG/HTML 카드) -->
                <div class="w-full bg-white rounded-2xl p-5 flex flex-col items-center justify-center shadow-lg border-2 border-slate-200">
                    <span class="text-xs text-neutral-600 font-extrabold tracking-widest mb-1">수학을 <span class="text-red-500">·</span>빛나게 하는곳</span>
                    <div class="flex items-center space-x-1.5 text-black font-black text-5xl tracking-tighter my-1">
                        <span>수</span>
                        <span>해</span>
                        <span>나</span>
                    </div>
                    <span class="text-xs text-red-900 font-black tracking-widest mt-1">수 학 학 원</span>
                </div>

                <div class="space-y-1">
                    <h1 class="text-2xl font-black text-yellow-400 drop-shadow">수해나에서 살아남기</h1>
                    <p class="text-slate-400 text-xs">수해나 수학학원 스릴 넘치는 생존 게임</p>
                </div>
            </div>

            <div class="w-full space-y-3 mb-4">
                <button onclick="startGame()" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-600 font-black text-lg rounded-2xl shadow-xl transition transform touch-active flex items-center justify-center space-x-2">
                    <span>🚀 학원 등원하기</span>
                </button>
                <button onclick="openRulesModal()" class="w-full py-3.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-sm rounded-2xl border border-slate-700 transition touch-active">
                    📖 게임 설명 / 규칙
                </button>
            </div>
        </div>

        <!-- 규칙 모달 -->
        <div id="modal-rules" class="hidden fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 max-w-xs w-full space-y-4 max-h-[85vh] overflow-y-auto shadow-2xl">
                <h2 class="text-lg font-black text-yellow-400 flex justify-between items-center border-b border-slate-700 pb-2">
                    <span>📖 학원 규칙 가이드</span>
                    <button onclick="closeRulesModal()" class="text-slate-400 hover:text-white p-1">✕</button>
                </h2>
                <div class="text-xs text-slate-300 space-y-3 leading-relaxed">
                    <p><strong class="text-emerald-400">1. 확인학습 (18:00~19:30):</strong> 랩실에서 친구들과 수다를 떨 수 있습니다. 쌤들이 랩실 안으로 완전히 들어왔을 때 떠들면 불이익(정답률 차감 및 자리 이동)이 발생합니다!</p>
                    <p><strong class="text-cyan-400">2. 복도 & 발자국:</strong> 70% 확률로 "뚜벅..." 발자국 소리가 나며 복도는 50% 확률로 개방됩니다.</p>
                    <p><strong class="text-purple-400">3. 쌤별 특징 & 대사:</strong>
                        <br>• 부원장쌤: 게이지 대폭 변화 / "떠들지 마라!" (자리 이동)
                        <br>• 2강쌤: 게이지 중간 유지 / "몸이 좀 돌아가 있는 것 같은데"
                        <br>• 실장쌤: 게이지 변화 거의 없음 / 대사 없이 순찰
                        <br>• 4강/5강쌤: 게이지 중상 유지 / "떠들지 마세요" or "부원장님!"
                        <br>• 데스크쌤: 변화 없음 / "어 조용히 해 주세요"
                    </p>
                    <p><strong class="text-amber-400">4. 전화 연출:</strong> 랩실 밖 데스크쌤의 "오늘 못 온답니다" 연출 후 쌤들의 분노 상승!</p>
                    <p><strong class="text-pink-400">5. 채점 & 본수업 (19:30~21:00):</strong> 타이밍 바 정답률 60% 초과 필수! 부원장쌤 레이더를 피해 졸기. (3회 경고 시 남아서 공부!)</p>
                </div>
                <button onclick="closeRulesModal()" class="w-full py-3 bg-emerald-500 font-bold rounded-xl text-white text-sm touch-active">알겠습니다</button>
            </div>
        </div>

        <!-- 게임 진행 화면 -->
        <div id="screen-game" class="hidden flex-1 flex flex-col justify-between space-y-3">
            <!-- 상단 상태 바 -->
            <div class="w-full bg-slate-800/90 backdrop-blur border border-slate-700/80 rounded-xl p-2.5 flex justify-between items-center text-xs">
                <div class="flex items-center space-x-1">
                    <span class="text-slate-400">🕒</span>
                    <span id="game-timer" class="font-mono font-black text-yellow-400 text-sm">18:00</span>
                </div>
                <div class="flex items-center space-x-1">
                    <span id="stage-text" class="font-bold text-emerald-400">확인학습</span>
                </div>
                <div class="flex items-center space-x-1">
                    <span class="text-slate-400">정답률:</span>
                    <span id="accuracy-display" class="font-mono font-black text-cyan-400 text-sm">100%</span>
                </div>
            </div>

            <!-- Canvas Area -->
            <div id="canvas-area" class="canvas-container bg-slate-950 rounded-2xl overflow-hidden border-2 border-slate-700/80 shadow-2xl relative">
                <canvas id="gameCanvas" width="400" height="300" class="w-full h-full block"></canvas>
            </div>

            <!-- 하단 선생님 분노 게이지 패널 -->
            <div id="rage-panel" class="w-full bg-slate-800/80 border border-slate-700/70 rounded-xl p-2 grid grid-cols-6 gap-1.5 text-center text-[10px]">
                <div class="flex flex-col items-center">
                    <span class="font-bold text-red-400 mb-0.5">부원장</span>
                    <div class="w-full bg-slate-950 h-9 rounded-full overflow-hidden flex flex-col justify-end p-0.5 border border-slate-800">
                        <div id="rage-bar-principal" class="bg-red-500 w-full rounded-full transition-all duration-300" style="height: 20%;"></div>
                    </div>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-orange-400 mb-0.5">2강쌤</span>
                    <div class="w-full bg-slate-950 h-9 rounded-full overflow-hidden flex flex-col justify-end p-0.5 border border-slate-800">
                        <div id="rage-bar-class2" class="bg-orange-500 w-full rounded-full transition-all duration-300" style="height: 40%;"></div>
                    </div>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-blue-400 mb-0.5">실장쌤</span>
                    <div class="w-full bg-slate-950 h-9 rounded-full overflow-hidden flex flex-col justify-end p-0.5 border border-slate-800">
                        <div id="rage-bar-manager" class="bg-blue-500 w-full rounded-full transition-all duration-300" style="height: 5%;"></div>
                    </div>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-purple-400 mb-0.5">4강쌤</span>
                    <div class="w-full bg-slate-950 h-9 rounded-full overflow-hidden flex flex-col justify-end p-0.5 border border-slate-800">
                        <div id="rage-bar-class4" class="bg-purple-500 w-full rounded-full transition-all duration-300" style="height: 65%;"></div>
                    </div>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-pink-400 mb-0.5">5강쌤</span>
                    <div class="w-full bg-slate-950 h-9 rounded-full overflow-hidden flex flex-col justify-end p-0.5 border border-slate-800">
                        <div id="rage-bar-class5" class="bg-pink-500 w-full rounded-full transition-all duration-300" style="height: 70%;"></div>
                    </div>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-cyan-400 mb-0.5">데스크</span>
                    <div class="w-full bg-slate-950 h-9 rounded-full overflow-hidden flex flex-col justify-end p-0.5 border border-slate-800">
                        <div id="rage-bar-desk" class="bg-cyan-500 w-full rounded-full transition-all duration-300" style="height: 0%;"></div>
                    </div>
                </div>
            </div>

            <!-- 채점 전용 UI -->
            <div id="screen-grading" class="hidden w-full bg-slate-800 border border-slate-700 rounded-2xl p-4 text-center space-y-3">
                <div class="flex items-center justify-center space-x-2">
                    <div id="grading-teacher-badge" class="w-8 h-8 rounded-full flex items-center justify-center font-black text-xs text-white shadow">
                        쌤
                    </div>
                    <h3 id="grading-room-title" class="text-base font-bold text-yellow-400">1강 채점실</h3>
                </div>
                <p id="grading-teacher-title" class="text-slate-300 text-xs">선생님 채점 진행 중</p>
                
                <div id="grading-speech-bubble" class="hidden bg-slate-900 border border-yellow-500/50 text-yellow-300 p-2.5 rounded-xl text-xs font-bold shadow-inner">
                    ...
                </div>

                <div id="music-notes" class="hidden text-pink-400 animate-pulse text-sm font-bold">
                    🎵 🎶 🎵 🎶
                </div>

                <!-- 빠른 타이밍 바 -->
                <div class="relative w-full h-8 bg-slate-950 rounded-full border-2 border-slate-700 overflow-hidden my-2">
                    <div class="absolute left-1/3 w-1/3 h-full bg-emerald-500/30 border-x-2 border-emerald-400 flex items-center justify-center text-[10px] text-emerald-300 font-bold">
                        PERFECT
                    </div>
                    <div id="coin" class="absolute top-0.5 bottom-0.5 w-7 bg-yellow-400 rounded-full shadow-lg flex items-center justify-center font-black text-slate-900 text-xs">
                        🪙
                    </div>
                </div>

                <button onclick="stopCoin()" class="w-full py-3.5 bg-yellow-500 active:bg-yellow-600 text-slate-950 font-black text-base rounded-xl shadow-lg transition touch-active">
                    🎯 정답률 맞추기!
                </button>
                <div id="grading-result" class="text-xs font-bold h-5"></div>
            </div>

            <!-- 하단 컨트롤 버튼 영역 -->
            <div id="action-controls" class="w-full pt-1">
                <button id="btn-talk" class="w-full py-4 bg-gradient-to-r from-rose-500 to-red-600 text-white font-black text-lg rounded-2xl shadow-xl transition transform touch-active select-none border border-rose-400/30 flex items-center justify-center space-x-2">
                    <span>🗣️ 친구들과 수다 떨기 (꾹 누르기!)</span>
                </button>
                <button id="btn-sleep" class="hidden w-full py-4 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-black text-lg rounded-2xl shadow-xl transition transform touch-active select-none border border-indigo-400/30 flex items-center justify-center space-x-2">
                    <span>😴 눈 붙이기 (졸기 버튼)</span>
                </button>
            </div>

            <!-- 게임 실시간 로그 -->
            <div id="game-log" class="w-full h-16 bg-slate-950/90 border border-slate-800 rounded-xl p-2 overflow-y-auto text-[10px] font-mono text-slate-400 space-y-0.5">
                <div class="text-emerald-400">> 수해나 수학학원에 입장했습니다.</div>
            </div>
        </div>

        <!-- 게임 결과 화면 -->
        <div id="screen-result" class="hidden flex-1 flex flex-col justify-center items-center text-center space-y-5 my-auto">
            <h2 id="result-title" class="text-3xl font-black">결과</h2>
            <p id="result-desc" class="text-slate-300 text-xs leading-relaxed px-2"></p>
            <div class="w-full p-4 bg-slate-950/80 rounded-2xl border border-slate-800 text-left text-xs space-y-2">
                <div class="flex justify-between"><span>최종 정답률:</span><span id="final-accuracy" class="font-bold text-yellow-400">0%</span></div>
                <div class="flex justify-between"><span>수업 졸기 적발:</span><span id="final-caught" class="font-bold text-rose-400">0회</span></div>
            </div>
            <button onclick="resetToMainScreen()" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-600 font-black rounded-2xl text-white text-base shadow-lg transition touch-active">
                🔄 메인 화면으로 돌아가기
            </button>
        </div>

    </div>

    <script>
        const teachers = [
            { id: 'principal', name: '부원장쌤', shortName: '부', color: '#ef4444' },
            { id: 'class2', name: '2강쌤', shortName: '2', color: '#f97316' },
            { id: 'manager', name: '실장쌤', shortName: '실', color: '#3b82f6' },
            { id: 'class4', name: '4강쌤', shortName: '4', color: '#8b5cf6' },
            { id: 'class5', name: '5강쌤', shortName: '5', color: '#ec4899' },
            { id: 'desk', name: '데스크쌤', shortName: '데', color: '#06b6d4' }
        ];

        let rageLevels = { principal: 20, class2: 40, manager: 5, class4: 65, class5: 70, desk: 0 };

        let currentStage = 'LAB';
        let accuracyRate = 100;
        let mainLoopTimer = null;
        let isTalking = false;
        let isSleeping = false;
        let isSeatMoved = false;
        let caughtSleepCount = 0;
        let lastCaughtTeacherId = null;

        let currentLabTeacher = null;
        let labTeacherTimer = 0;
        let speechBubbleText = '';
        let speechBubbleTimer = 0;
        let footstepNotice = false;
        let isCorridorRevealed = false;
        let teacherX = 350;
        let teacherY = 130;
        let managerPatrolDirection = 1;

        let deskOutsideTimer = 0;
        let deskOutsideText = "";

        let radarAngle = 0;
        let radarSpeed = 0.035;
        let isCaughtThisFrame = false;
        let lectureAnimationFrameId = null;

        let coinPos = 0;
        let coinDir = 1;
        let coinAnimFrame = null;
        let currentGradingTeacher = null;

        const friendTalkList = ['숙제 다함??', '집 갈래', '아니 왜 저럼'];

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const timerText = document.getElementById('game-timer');
        const stageText = document.getElementById('stage-text');
        const accuracyDisplay = document.getElementById('accuracy-display');
        const logContainer = document.getElementById('game-log');
        const btnTalk = document.getElementById('btn-talk');
        const btnSleep = document.getElementById('btn-sleep');

        function log(msg) {
            const div = document.createElement('div');
            div.textContent = `> ${msg}`;
            logContainer.appendChild(div);
            logContainer.scrollTop = logContainer.scrollHeight;
        }

        function openRulesModal() { document.getElementById('modal-rules').classList.remove('hidden'); }
        function closeRulesModal() { document.getElementById('modal-rules').classList.add('hidden'); }

        function setScreen(screenName) {
            document.getElementById('screen-main').classList.add('hidden');
            document.getElementById('screen-game').classList.add('hidden');
            document.getElementById('screen-result').classList.add('hidden');
            document.getElementById('screen-grading').classList.add('hidden');
            document.getElementById('canvas-area').classList.add('hidden');

            if (screenName === 'main') {
                document.getElementById('screen-main').classList.remove('hidden');
            } else if (screenName === 'game') {
                document.getElementById('screen-game').classList.remove('hidden');
                document.getElementById('canvas-area').classList.remove('hidden');
            } else if (screenName === 'grading') {
                document.getElementById('screen-game').classList.remove('hidden');
                document.getElementById('screen-grading').classList.remove('hidden');
            } else if (screenName === 'result') {
                document.getElementById('screen-result').classList.remove('hidden');
            }
        }

        function resetToMainScreen() {
            if (mainLoopTimer) clearInterval(mainLoopTimer);
            if (coinAnimFrame) cancelAnimationFrame(coinAnimFrame);
            if (lectureAnimationFrameId) cancelAnimationFrame(lectureAnimationFrameId);

            currentStage = 'LAB';
            accuracyRate = 100;
            isTalking = false;
            isSleeping = false;
            isSeatMoved = false;
            caughtSleepCount = 0;
            lastCaughtTeacherId = null;

            rageLevels = { principal: 20, class2: 40, manager: 5, class4: 65, class5: 70, desk: 0 };
            currentLabTeacher = null;
            labTeacherTimer = 0;
            speechBubbleText = '';
            speechBubbleTimer = 0;
            footstepNotice = false;
            isCorridorRevealed = false;

            updateAccuracyUI();
            logContainer.innerHTML = '<div class="text-emerald-400">> 수해나 수학학원에 입장했습니다.</div>';
            setScreen('main');
        }

        function handleCaughtTalking(teacher) {
            if (lastCaughtTeacherId === teacher.id && speechBubbleTimer > 1.5) return;

            lastCaughtTeacherId = teacher.id;
            speechBubbleTimer = 3;

            const penalty = (teacher.id === 'principal' || teacher.id === 'class5') ? 10 : 5;
            accuracyRate = Math.max(0, accuracyRate - penalty);
            updateAccuracyUI();

            if (teacher.id === 'principal') {
                speechBubbleText = "떠들지 마라!";
                isSeatMoved = true;
                log(`🚨 [적발] 부원장쌤: "떠들지 마라!" (자리가 멀리 떨어짐 & 정답률 -${penalty}%)`);
            } else if (teacher.id === 'class2') {
                speechBubbleText = "몸이 좀 돌아가 있는 것 같은데";
                log(`⚠️ [적발] 2강쌤: "몸이 좀 돌아가 있는 것 같은데" (정답률 -${penalty}%)`);
            } else if (teacher.id === 'manager') {
                speechBubbleText = ""; 
                log(`🤫 [적발] 실장쌤이 아무 말 없이 랩실 내부를 서성입니다. (정답률 -${penalty}%)`);
            } else if (teacher.id === 'class4') {
                speechBubbleText = "떠들지 마세요";
                log(`💬 [적발] 4강쌤: "떠들지 마세요" (정답률 -${penalty}%)`);
            } else if (teacher.id === 'class5') {
                speechBubbleText = "부원장님!";
                isSeatMoved = true;
                log(`🚨 [적발] 5강쌤: "부원장님!"을 불러 부원장쌤과 동일하게 자리가 멀리 옮겨짐! (정답률 -${penalty}%)`);
            } else if (teacher.id === 'desk') {
                speechBubbleText = "어 조용히 해 주세요";
                log(`💬 [적발] 데스크쌤: "어 조용히 해 주세요" (정답률 -${penalty}%)`);
            }
        }

        function updateAccuracyUI() {
            accuracyDisplay.textContent = `${accuracyRate}%`;
        }

        function updateRageGauges() {
            rageLevels.principal += (Math.random() - 0.5) * 20;
            if (rageLevels.principal < 0) rageLevels.principal = 0;
            if (rageLevels.principal > 100) rageLevels.principal = 100;

            rageLevels.class2 += (Math.random() - 0.5) * 8;
            if (rageLevels.class2 < 20) rageLevels.class2 = 20;
            if (rageLevels.class2 > 80) rageLevels.class2 = 80;

            if (Math.random() < 0.05) rageLevels.manager = Math.min(100, rageLevels.manager + 30);

            rageLevels.class4 = 60 + (Math.random() - 0.5) * 10;
            rageLevels.class5 = 65 + (Math.random() - 0.5) * 10;
            rageLevels.desk = 0;

            document.getElementById('rage-bar-principal').style.height = `${rageLevels.principal}%`;
            document.getElementById('rage-bar-class2').style.height = `${rageLevels.class2}%`;
            document.getElementById('rage-bar-manager').style.height = `${rageLevels.manager}%`;
            document.getElementById('rage-bar-class4').style.height = `${rageLevels.class4}%`;
            document.getElementById('rage-bar-class5').style.height = `${rageLevels.class5}%`;
            document.getElementById('rage-bar-desk').style.height = `${rageLevels.desk}%`;
        }

        btnTalk.addEventListener('mousedown', () => isTalking = true);
        btnTalk.addEventListener('mouseup', () => isTalking = false);
        btnTalk.addEventListener('mouseleave', () => isTalking = false);
        btnTalk.addEventListener('touchstart', (e) => { e.preventDefault(); isTalking = true; });
        btnTalk.addEventListener('touchend', (e) => { e.preventDefault(); isTalking = false; });

        btnSleep.addEventListener('mousedown', () => isSleeping = true);
        btnSleep.addEventListener('mouseup', () => isSleeping = false);
        btnSleep.addEventListener('mouseleave', () => isSleeping = false);
        btnSleep.addEventListener('touchstart', (e) => { e.preventDefault(); isSleeping = true; });
        btnSleep.addEventListener('touchend', (e) => { e.preventDefault(); isSleeping = false; });

        function startGame() {
            setScreen('game');
            startLabStage();
        }

        function triggerPhoneCallSequence() {
            const targetTeacher = teachers[Math.floor(Math.random() * (teachers.length - 1))];
            deskOutsideTimer = 3;
            deskOutsideText = `데스크쌤: "선생님, 이 학생 오늘 학원 못 온답니다!"`;
            
            setTimeout(() => {
                if (currentStage === 'LAB') {
                    speechBubbleTimer = 3;
                    speechBubbleText = "전화 바꿔주세요";
                    rageLevels[targetTeacher.id] = Math.min(100, rageLevels[targetTeacher.id] + 20);
                    log(`📱 [전화 알림] 랩실 밖 데스크쌤 대사 후 ${targetTeacher.name}: "전화 바꿔주세요" (분노 상승)`);
                }
            }, 1200);
        }

        function startLabStage() {
            currentStage = 'LAB';
            stageText.textContent = "확인학습 (18:00~19:30)";
            btnTalk.classList.remove('hidden');
            btnSleep.classList.add('hidden');

            let elapsed = 0;
            const labTotalDuration = 20;

            if (mainLoopTimer) clearInterval(mainLoopTimer);

            mainLoopTimer = setInterval(() => {
                elapsed++;
                const mins = Math.floor((elapsed / labTotalDuration) * 90);
                const totalMins = 1080 + mins;
                const displayHour = Math.floor(totalMins / 60);
                const displayMin = totalMins % 60;
                timerText.textContent = `${displayHour}:${displayMin < 10 ? '0' + displayMin : displayMin}`;

                updateRageGauges();

                if (labTeacherTimer <= 0) {
                    if (currentLabTeacher) {
                        currentLabTeacher = null;
                        footstepNotice = false;
                        labTeacherTimer = Math.floor(2 + Math.random() * 3);
                    } else {
                        isCorridorRevealed = Math.random() < 0.5;

                        if (Math.random() < 0.70) {
                            footstepNotice = true;
                            log("👣 뚜벅... 뚜벅... 선생님 발자국 소리가 들립니다!");
                        }
                        currentLabTeacher = teachers[Math.floor(Math.random() * teachers.length)];
                        labTeacherTimer = Math.floor(4 + Math.random() * 4);
                        teacherX = 350;
                        teacherY = 130;

                        if (Math.random() < 0.3) {
                            triggerPhoneCallSequence();
                        }
                    }
                } else {
                    labTeacherTimer--;
                }

                if (elapsed >= labTotalDuration) {
                    clearInterval(mainLoopTimer);
                    startGradingStage();
                }
            }, 1000);

            requestAnimationFrame(renderLabCanvasLoop);
        }

        function renderLabCanvasLoop() {
            if (currentStage !== 'LAB') return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 랩실 배경
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // 랩실 창문 및 경계선
            ctx.strokeStyle = '#475569';
            ctx.lineWidth = 3;
            ctx.strokeRect(5, 5, 275, 290);

            // 복도 영역
            if (isCorridorRevealed) {
                ctx.fillStyle = '#334155';
                ctx.fillRect(285, 5, 110, 290);
                ctx.fillStyle = '#94a3b8';
                ctx.font = 'bold 9px sans-serif';
                ctx.fillText('🚪 복도 (개방)', 300, 20);
            } else {
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(285, 5, 110, 290);
                ctx.fillStyle = '#475569';
                ctx.font = 'bold 9px sans-serif';
                ctx.fillText('🔒 복도 (가려짐)', 300, 20);
            }

            // 복도 데스크쌤 전화 알림
            if (deskOutsideTimer > 0 && isCorridorRevealed) {
                deskOutsideTimer -= 0.016;
                ctx.fillStyle = '#06b6d4';
                ctx.beginPath();
                ctx.arc(330, 45, 11, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 9px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('데', 330, 48);
                ctx.textAlign = 'left';

                ctx.fillStyle = '#ffffff';
                ctx.fillRect(225, 62, 165, 20);
                ctx.fillStyle = '#0f172a';
                ctx.font = 'bold 8px sans-serif';
                ctx.fillText("데스크쌤: 오늘 못 온답니다!", 230, 75);
            }

            // 발자국 소리 경고
            if (footstepNotice && !currentLabTeacher) {
                ctx.fillStyle = '#f59e0b';
                ctx.font = 'bold 13px sans-serif';
                ctx.fillText('👣 뚜벅... 뚜벅...', 100, 30);
            }

            // 학생 좌석
            const students = [
                { name: '친구A', x: 60, y: 210 },
                { name: '친구B', x: 130, y: 210 },
                { name: '친구C', x: 200, y: 210 }
            ];

            students.forEach((s, idx) => {
                ctx.fillStyle = '#3b82f6';
                ctx.beginPath();
                ctx.arc(s.x, s.y, 13, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 9px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(s.name, s.x, s.y + 3);
                ctx.textAlign = 'left';

                if (isTalking) {
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(s.x - 22, s.y - 30, 50, 16);
                    ctx.fillStyle = '#0f172a';
                    ctx.font = 'bold 8px sans-serif';
                    ctx.fillText(friendTalkList[idx], s.x - 18, s.y - 19);
                }
            });

            // 플레이어 좌석
            const pX = isSeatMoved ? 130 : 60;
            const pY = isSeatMoved ? 110 : 110;

            ctx.fillStyle = '#10b981';
            ctx.beginPath();
            ctx.arc(pX, pY, 14, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 10px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('나', pX, pY + 3);
            ctx.textAlign = 'left';

            if (isTalking) {
                ctx.fillStyle = '#fde047';
                ctx.fillRect(pX - 20, pY - 32, 45, 16);
                ctx.fillStyle = '#0f172a';
                ctx.font = 'bold 8px sans-serif';
                ctx.fillText('속닥속닥', pX - 16, pY - 21);
            }

            // 선생님 랩실 진입 이동 애니메이션
            if (currentLabTeacher) {
                if (labTeacherTimer > 1) {
                    if (teacherX > 220) teacherX -= 2.5;
                } else {
                    teacherX += 3;
                }

                const isInLab = teacherX <= 270;
                if (isTalking && isInLab) {
                    handleCaughtTalking(currentLabTeacher);
                }

                if (currentLabTeacher.id === 'manager' && isInLab) {
                    teacherY += managerPatrolDirection * 1.2;
                    if (teacherY > 240 || teacherY < 50) managerPatrolDirection *= -1;
                }

                if (teacherX > 275 && !isCorridorRevealed) {
                    // 복도가 가려진 경우 비노출
                } else {
                    ctx.fillStyle = currentLabTeacher.color;
                    ctx.beginPath();
                    ctx.arc(teacherX, teacherY, 15, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = '#ffffff';
                    ctx.font = 'bold 10px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(currentLabTeacher.shortName, teacherX, teacherY + 3);
                    ctx.textAlign = 'left';

                    if (speechBubbleTimer > 0 && speechBubbleText !== "") {
                        speechBubbleTimer -= 0.016;
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(teacherX - 110, teacherY - 35, 120, 24);
                        ctx.fillStyle = '#000000';
                        ctx.font = 'bold 8px sans-serif';
                        ctx.fillText(speechBubbleText, teacherX - 105, teacherY - 20);
                    }
                }
            }

            requestAnimationFrame(renderLabCanvasLoop);
        }

        function startGradingStage() {
            currentStage = 'GRADING';
            stageText.textContent = "숙제 채점 진행 중";
            setScreen('grading');

            const isManagerRoom = Math.random() < 0.5;
            currentGradingTeacher = isManagerRoom ? teachers.find(t => t.id === 'manager') : teachers.find(t => t.id === 'principal');

            document.getElementById('grading-room-title').textContent = isManagerRoom ? '3강 채점실' : '1강 채점실';
            document.getElementById('grading-teacher-title').textContent = `${currentGradingTeacher.name} 채점 진행 중`;

            const teacherBadge = document.getElementById('grading-teacher-badge');
            teacherBadge.textContent = currentGradingTeacher.shortName;
            teacherBadge.style.backgroundColor = currentGradingTeacher.color;

            const musicNotes = document.getElementById('music-notes');
            if (isManagerRoom) musicNotes.classList.remove('hidden');
            else musicNotes.classList.add('hidden');

            document.getElementById('grading-speech-bubble').classList.add('hidden');
            document.getElementById('grading-result').textContent = '';

            coinPos = 0;
            coinDir = 1;
            const coinEl = document.getElementById('coin');

            function animCoin() {
                coinPos += 3.5 * coinDir;
                if (coinPos >= 90) coinDir = -1;
                if (coinPos <= 0) coinDir = 1;
                coinEl.style.left = `${coinPos}%`;
                coinAnimFrame = requestAnimationFrame(animCoin);
            }
            if (coinAnimFrame) cancelAnimationFrame(coinAnimFrame);
            animCoin();
        }

        function stopCoin() {
            if (coinAnimFrame) cancelAnimationFrame(coinAnimFrame);

            const perfectZoneStart = 33.3;
            const perfectZoneEnd = 66.6;
            let hitAccuracy = 0;

            if (coinPos >= perfectZoneStart && coinPos <= perfectZoneEnd) {
                hitAccuracy = Math.floor(75 + Math.random() * 25);
                document.getElementById('grading-result').innerHTML = `<span class="text-emerald-400">🎯 PERFECT! 정답률 ${hitAccuracy}% 획득!</span>`;
            } else {
                hitAccuracy = Math.floor(20 + Math.random() * 35);
                document.getElementById('grading-result').innerHTML = `<span class="text-rose-400">⚠️ 아쉬운 타이밍! 정답률 ${hitAccuracy}%</span>`;
            }

            accuracyRate = Math.round((accuracyRate + hitAccuracy) / 2);
            updateAccuracyUI();

            const isBadScore = hitAccuracy < 50;

            if (currentGradingTeacher.id === 'manager') {
                const speechEl = document.getElementById('grading-speech-bubble');
                speechEl.classList.remove('hidden');
                if (isBadScore) {
                    speechEl.textContent = '언니 와 이래 많이 틀렸노';
                } else {
                    speechEl.textContent = '🎵 (흥얼흥얼 노래를 부르십니다~) 🎶';
                }
            } else if (currentGradingTeacher.id === 'principal') {
                const speechEl = document.getElementById('grading-speech-bubble');
                if (isBadScore) {
                    speechEl.classList.remove('hidden');
                    if (rageLevels.principal > 50) speechEl.textContent = '지금 사람 많은데 이렇게 많이 풀어오면...';
                    else speechEl.textContent = '어머 많이 틀렸네!';
                } else {
                    speechEl.classList.add('hidden');
                }
            }

            log(`숙제 채점 완료: 최종 정답률 ${accuracyRate}%`);

            setTimeout(() => {
                startLectureStage();
            }, 2000);
        }

        function startLectureStage() {
            currentStage = 'LECTURE';
            stageText.textContent = "본수업 (19:30~21:00)";
            setScreen('game');
            btnTalk.classList.add('hidden');
            btnSleep.classList.remove('hidden');

            log("본수업 시작 (부원장쌤 전담 수업)");

            let lectureDuration = 20; 
            let elapsed = 0;

            if (lectureAnimationFrameId) cancelAnimationFrame(lectureAnimationFrameId);
            renderLectureCanvasScene();

            if (mainLoopTimer) clearInterval(mainLoopTimer);

            mainLoopTimer = setInterval(() => {
                elapsed++;
                const mins = Math.floor((elapsed / lectureDuration) * 90);
                const totalMins = 1170 + mins;
                const displayHour = Math.floor(totalMins / 60);
                const displayMin = totalMins % 60;
                timerText.textContent = `${displayHour}:${displayMin < 10 ? '0' + displayMin : displayMin}`;

                if (elapsed >= lectureDuration) {
                    clearInterval(mainLoopTimer);
                    if (lectureAnimationFrameId) cancelAnimationFrame(lectureAnimationFrameId);
                    finishGame();
                }
            }, 1000);
        }

        function renderLectureCanvasScene() {
            if (currentStage !== 'LECTURE') return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // 칠판
            ctx.fillStyle = '#064e3b';
            ctx.fillRect(80, 15, 240, 70);
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 11px sans-serif';
            ctx.fillText('1강 개념 수업 (부원장쌤)', 135, 40);
            ctx.font = '9px sans-serif';
            ctx.fillStyle = '#a7f3d0';
            ctx.fillText('∫ f(x)dx = F(x) + C', 150, 60);

            const teacherX = 200;
            const teacherY = 100;
            ctx.fillStyle = '#ef4444';
            ctx.beginPath();
            ctx.arc(teacherX, teacherY, 15, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 9px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('부', teacherX, teacherY + 3);
            ctx.textAlign = 'left';

            radarAngle += radarSpeed;
            if (radarAngle > Math.PI * 0.75 || radarAngle < -Math.PI * 0.75) {
                radarSpeed = -radarSpeed;
            }

            const sweepAngle = Math.PI / 4;
            const currentDirection = Math.PI / 2 + radarAngle;

            ctx.fillStyle = 'rgba(239, 68, 68, 0.35)';
            ctx.beginPath();
            ctx.moveTo(teacherX, teacherY);
            ctx.arc(teacherX, teacherY, 170, currentDirection - sweepAngle / 2, currentDirection + sweepAngle / 2);
            ctx.closePath();
            ctx.fill();

            const myX = 200;
            const myY = 240;

            ctx.fillStyle = isSleeping ? '#6366f1' : '#10b981';
            ctx.beginPath();
            ctx.arc(myX, myY, 14, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 9px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(isSleeping ? '😴 나' : '나', myX, myY + 3);
            ctx.textAlign = 'left';

            const angleToPlayer = Math.atan2(myY - teacherY, myX - teacherX);
            let angleDiff = Math.abs(angleToPlayer - currentDirection);
            while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
            angleDiff = Math.abs(angleDiff);

            if (angleDiff < sweepAngle / 2 && isSleeping) {
                if (!isCaughtThisFrame) {
                    isCaughtThisFrame = true;
                    caughtSleepCount++;
                    accuracyRate = Math.max(0, accuracyRate - 15);
                    updateAccuracyUI();
                    
                    log(`🚨 [자다 적발!] 부원장쌤: "자지 마라!" (경고 ${caughtSleepCount}/3회)`);

                    if (caughtSleepCount >= 3) {
                        clearInterval(mainLoopTimer);
                        cancelAnimationFrame(lectureAnimationFrameId);
                        finishGame(true);
                        return;
                    }

                    setTimeout(() => { isCaughtThisFrame = false; }, 2000);
                }
            }

            if (isCaughtThisFrame) {
                ctx.fillStyle = '#ef4444';
                ctx.font = 'bold 14px sans-serif';
                ctx.fillText('⚡ 부원장쌤: "자지 마라!"', 130, 140);
            }

            lectureAnimationFrameId = requestAnimationFrame(renderLectureCanvasScene);
        }

        function finishGame(forcedFail = false) {
            setScreen('result');
            const resultTitle = document.getElementById('result-title');
            const resultDesc = document.getElementById('result-desc');

            document.getElementById('final-accuracy').textContent = `${accuracyRate}%`;
            document.getElementById('final-caught').textContent = `${caughtSleepCount}회`;

            const isLowAccuracy = accuracyRate <= 60;

            if (forcedFail || caughtSleepCount >= 3 || isLowAccuracy) {
                resultTitle.textContent = "😭 남게 되었습니다!";
                resultTitle.className = "text-3xl font-black text-rose-500";
                
                if (caughtSleepCount >= 3) {
                    resultDesc.textContent = "수업 시간 중 3회 이상 졸다가 부원장쌤에게 적발되어 남아서 공부해야 합니다!";
                } else {
                    resultDesc.textContent = `최종 정답률이 ${accuracyRate}%로 기준치(60% 초과) 미만이므로 남아서 공부해야 합니다!`;
                }
            } else {
                resultTitle.textContent = "🎉 무사히 하교 성공!";
                resultTitle.className = "text-3xl font-black text-emerald-400";
                resultDesc.textContent = `정답률 ${accuracyRate}% 달성! 무사히 확인학습과 본수업을 마치고 하교에 성공했습니다!`;
            }
        }
    </script>
</body>
</html>