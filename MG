    // SCRATCHPAD LOGIC
    let isDrawing = false;
    let scratchpadCtx = null;

    function initScratchpad() {
      const cvs = document.getElementById('scratchpad-canvas');
      cvs.width = cvs.parentElement.clientWidth || 300;
      cvs.height = cvs.parentElement.clientHeight || 300;
      scratchpadCtx = cvs.getContext('2d');
      scratchpadCtx.strokeStyle = '#0369a1';
      scratchpadCtx.lineWidth = 3;
      scratchpadCtx.lineCap = 'round';

      function getPos(e) {
        const rect = cvs.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - rect.left, y: clientY - rect.top };
      }

      function startDraw(e) {
        isDrawing = true;
        const p = getPos(e);
        scratchpadCtx.beginPath();
        scratchpadCtx.moveTo(p.x, p.y);
      }

      function draw(e) {
        if (!isDrawing) return;
        const p = getPos(e);
        scratchpadCtx.lineTo(p.x, p.y);
        scratchpadCtx.stroke();
      }

      function endDraw() { isDrawing = false; }

      cvs.addEventListener('mousedown', startDraw);
      cvs.addEventListener('mousemove', draw);
      cvs.addEventListener('mouseup', endDraw);
      cvs.addEventListener('touchstart', startDraw);
      cvs.addEventListener('touchmove', draw);
      cvs.addEventListener('touchend', endDraw);
    }

    function toggleScratchpad() {
      const pad = document.getElementById('scratchpad-overlay');
      pad.classList.toggle('hidden');
      if (!pad.classList.contains('hidden')) {
        setTimeout(initScratchpad, 100);
      }
    }

    function clearScratchpad() {
      const cvs = document.getElementById('scratchpad-canvas');
      if (scratchpadCtx) scratchpadCtx.clearRect(0, 0, cvs.width, cvs.height);
    }

    /* ==========================================================================
       HIGH-QUALITY CANVAS GAME ENGINES (REAL PHYSICS & ANIMATIONS)
       ========================================================================== */
    function initCanvasGame(gameType) {
      if (appState.gameCanvasAnimationId) cancelAnimationFrame(appState.gameCanvasAnimationId);

      const canvas = document.getElementById('game-canvas');
      const container = document.getElementById('canvas-container');
      canvas.width = container.clientWidth || 600;
      canvas.height = container.clientHeight || 340;
      const ctx = canvas.getContext('2d');

      const currentQ = appState.currentQuizList[appState.currentQuizIdx];

      if (gameType === 'racing') runRacingGame(canvas, ctx, currentQ);
      else if (gameType === 'stack') runStackGame(canvas, ctx, currentQ);
      else if (gameType === 'chairs') runChairsGame(canvas, ctx, currentQ);
      else if (gameType === 'mafia') runMafiaGame(canvas, ctx, currentQ);
      else runRouletteGame(canvas, ctx, currentQ);
    }

    // 1. HIGH QUALITY RACING GAME ENGINE
    function runRacingGame(canvas, ctx, quizData) {
      document.getElementById('game-hud-title').innerHTML = `<i class="fa-solid fa-car-side text-yellow-400"></i> 스피드 레이싱: 방향키로 차선을 이동하고 액션 버튼으로 정답 게이트로 진입하세요!`;

      let playerLane = 0;
      let targetX = 0;
      let currentX = 0;
      let laneWidth = canvas.width / 4;
      let roadSpeed = 8;
      let dashOffsetY = 0;

      targetX = playerLane * laneWidth + laneWidth / 2;
      currentX = targetX;

      function updateControlsUI() {
        document.getElementById('btn-control-left').innerHTML = `<i class="fa-solid fa-arrow-left"></i> 왼쪽 차선`;
        document.getElementById('btn-control-right').innerHTML = `오른쪽 차선 <i class="fa-solid fa-arrow-right"></i>`;
        document.getElementById('btn-control-action').innerHTML = `<i class="fa-solid fa-bolt"></i> 돌진 제출`;
      }
      updateControlsUI();

      function animate() {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Animated Road Markings
        dashOffsetY = (dashOffsetY + roadSpeed) % 40;

        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 4;
        for (let i = 1; i < 4; i++) {
          ctx.beginPath();
          ctx.setLineDash([20, 20]);
          ctx.lineDashOffset = -dashOffsetY;
          ctx.moveTo(i * laneWidth, 0);
          ctx.lineTo(i * laneWidth, canvas.height);
          ctx.stroke();
        }
        ctx.setLineDash([]);

        // Render Option Gates
        quizData.options.forEach((opt, idx) => {
          let gateX = idx * laneWidth;
          let isHovered = playerLane === idx;

          ctx.fillStyle = isHovered ? 'rgba(56, 189, 248, 0.3)' : 'rgba(30, 41, 59, 0.6)';
          ctx.fillRect(gateX + 4, 15, laneWidth - 8, 55);

          ctx.strokeStyle = isHovered ? '#facc15' : '#0284c7';
          ctx.lineWidth = isHovered ? 4 : 2;
          ctx.strokeRect(gateX + 4, 15, laneWidth - 8, 55);

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 14px "Jua", sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(`GATE ${idx + 1}`, gateX + laneWidth / 2, 48);
        });

        // Smooth Car Physics Interpolation
        currentX += (targetX - currentX) * 0.2;

        // Draw Player Sports Car
        let carY = canvas.height - 70;
        ctx.save();
        ctx.translate(currentX, carY);

        // Car Body Shadow
        ctx.fillStyle = 'rgba(0,0,0,0.4)';
        ctx.beginPath();
        ctx.ellipse(0, 25, 22, 8, 0, 0, Math.PI * 2);
        ctx.fill();

        // Car Main Frame
        ctx.fillStyle = '#facc15';
        ctx.beginPath();
        ctx.roundRect(-18, -30, 36, 55, 8);
        ctx.fill();
        ctx.strokeStyle = '#ca8a04';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Car Glass
        ctx.fillStyle = '#0f172a';
        ctx.beginPath();
        ctx.roundRect(-12, -15, 24, 18, 4);
        ctx.fill();

        // Car Headlights
        ctx.fillStyle = '#fef08a';
        ctx.fillRect(-14, -28, 6, 4);
        ctx.fillRect(8, -28, 6, 4);

        ctx.restore();

        appState.gameCanvasAnimationId = requestAnimationFrame(animate);
      }

      document.getElementById('btn-control-left').onclick = () => {
        playSfx('click');
        if (playerLane > 0) {
          playerLane--;
          targetX = playerLane * laneWidth + laneWidth / 2;
        }
      };
      document.getElementById('btn-control-right').onclick = () => {
        playSfx('click');
        if (playerLane < 3) {
          playerLane++;
          targetX = playerLane * laneWidth + laneWidth / 2;
        }
      };
      document.getElementById('btn-control-action').onclick = () => {
        playSfx('click');
        selectQuizOption(playerLane, document.getElementById('quiz-options-container').children[playerLane]);
        checkAnswerDirectly();
      };

      animate();
    }

    // 2. HIGH QUALITY MILK CRATE TOWER STACK GAME (PHYSICS ENGINE)
    function runStackGame(canvas, ctx, quizData) {
      document.getElementById('game-hud-title').innerHTML = `<i class="fa-solid fa-cubes text-sky-400"></i> 우유 상자 쌓기: 와이퍼로 움직이는 상자 번호를 맞춰 드롭하세요!`;

      let boxWidth = 100;
      let boxHeight = 40;
      let selectedOptIdx = 0;

      // Crane Pendulum Physics
      let swingAngle = 0;
      let swingSpeed = 0.04;

      let isDropping = false;
      let dropY = 50;
      let dropSpeedY = 0;
      let stackY = canvas.height - 45;

      function updateControlsUI() {
        document.getElementById('btn-control-left').innerHTML = `<i class="fa-solid fa-arrow-left"></i> 이전 보기`;
        document.getElementById('btn-control-right').innerHTML = `다음 보기 <i class="fa-solid fa-arrow-right"></i>`;
        document.getElementById('btn-control-action').innerHTML = `<i class="fa-solid fa-arrow-down"></i> 드롭 (Drop)`;
      }
      updateControlsUI();

      function animate() {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Tower Base
        ctx.fillStyle = '#38bdf8';
        ctx.beginPath();
        ctx.roundRect(canvas.width / 2 - 70, stackY, 140, 35, 8);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px "Jua", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('CRATE TOWER BASE', canvas.width / 2, stackY + 22);

        if (!isDropping) {
          swingAngle += swingSpeed;
          let currentX = (canvas.width / 2) + Math.sin(swingAngle) * (canvas.width / 2 - 80);

          // Crane Wire
          ctx.strokeStyle = '#94a3b8';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(canvas.width / 2, 0);
          ctx.lineTo(currentX, 60);
          ctx.stroke();

          // Swinging Box
          drawBox(currentX - boxWidth / 2, 60, selectedOptIdx + 1);
        } else {
          dropSpeedY += 0.8; // Gravity
          dropY += dropSpeedY;

          let targetBoxX = canvas.width / 2 - boxWidth / 2;
          drawBox(targetBoxX, dropY, selectedOptIdx + 1);

          if (dropY >= stackY - boxHeight) {
            playSfx('drop');
            isDropping = false;
            dropY = 50;
            dropSpeedY = 0;
            selectQuizOption(selectedOptIdx, document.getElementById('quiz-options-container').children[selectedOptIdx]);
            checkAnswerDirectly();
          }
        }

        appState.gameCanvasAnimationId = requestAnimationFrame(animate);
      }

      function drawBox(x, y, num) {
        ctx.fillStyle = '#facc15';
        ctx.beginPath();
        ctx.roundRect(x, y, boxWidth, boxHeight, 8);
        ctx.fill();
        ctx.strokeStyle = '#eab308';
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.fillStyle = '#713f12';
        ctx.font = 'bold 15px "Jua", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(`BOX ${num}`, x + boxWidth / 2, y + 25);
      }

      document.getElementById('btn-control-left').onclick = () => {
        playSfx('click');
        selectedOptIdx = (selectedOptIdx - 1 + quizData.options.length) % quizData.options.length;
      };
      document.getElementById('btn-control-right').onclick = () => {
        playSfx('click');
        selectedOptIdx = (selectedOptIdx + 1) % quizData.options.length;
      };
      document.getElementById('btn-control-action').onclick = () => {
        if (!isDropping) {
          playSfx('click');
          isDropping = true;
        }
      };

      animate();
    }

    // 3. MUSICAL CHAIRS GAME (ROTATING CAROUSEL)
    function runChairsGame(canvas, ctx, quizData) {
      document.getElementById('game-hud-title').innerHTML = `<i class="fa-solid fa-chair text-amber-400"></i> 의자 빼기: 회전하는 의자 중 정답 번호 의자를 빠르게 클릭하세요!`;

      let angle = 0;
      let radius = 100;
      let centerX = canvas.width / 2;
      let centerY = canvas.height / 2;

      function updateControlsUI() {
        document.getElementById('btn-control-left').innerHTML = `<i class="fa-solid fa-rotate-left"></i> 역회전`;
        document.getElementById('btn-control-right').innerHTML = `정회전 <i class="fa-solid fa-rotate-right"></i>`;
        document.getElementById('btn-control-action').innerHTML = `<i class="fa-solid fa-hand-pointer"></i> 직접 터치`;
      }
      updateControlsUI();

      function animate() {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        angle += 0.02;

        let numChairs = quizData.options.length;
        for (let i = 0; i < numChairs; i++) {
          let chairAngle = angle + (i * (Math.PI * 2 / numChairs));
          let cx = centerX + Math.cos(chairAngle) * radius;
          let cy = centerY + Math.sin(chairAngle) * radius;

          // Chair Circle Base
          ctx.fillStyle = '#38bdf8';
          ctx.beginPath();
          ctx.arc(cx, cy, 32, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#0284c7';
          ctx.lineWidth = 3;
          ctx.stroke();

          // Chair Label
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 15px "Jua", sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(`CHAIR ${i + 1}`, cx, cy + 5);
        }

        appState.gameCanvasAnimationId = requestAnimationFrame(animate);
      }

      canvas.onclick = (e) => {
        const rect = canvas.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const clickY = e.clientY - rect.top;

        let numChairs = quizData.options.length;
        for (let i = 0; i < numChairs; i++) {
          let chairAngle = angle + (i * (Math.PI * 2 / numChairs));
          let cx = centerX + Math.cos(chairAngle) * radius;
          let cy = centerY + Math.sin(chairAngle) * radius;

          let dist = Math.hypot(clickX - cx, clickY - cy);
          if (dist <= 35) {
            playSfx('click');
            selectQuizOption(i, document.getElementById('quiz-options-container').children[i]);
            checkAnswerDirectly();
            break;
          }
        }
      };

      animate();
    }

    // 4. MAFIA TRUTH GAME (SPOTLIGHT SEARCH)
    function runMafiaGame(canvas, ctx, quizData) {
      document.getElementById('game-hud-title').innerHTML = `<i class="fa-solid fa-user-secret text-rose-400"></i> 마피아 진실 게임: 4명의 용의자 중 정답을 소지한 진실된 인물을 선택하세요!`;

      let hoveredCard = -1;

      function updateControlsUI() {
        document.getElementById('btn-control-left').innerHTML = `<i class="fa-solid fa-arrow-left"></i> 이전 탐색`;
        document.getElementById('btn-control-right').innerHTML = `다음 탐색 <i class="fa-solid fa-arrow-right"></i>`;
        document.getElementById('btn-control-action').innerHTML = `<i class="fa-solid fa-magnifying-glass"></i> 용의자 검거`;
      }
      updateControlsUI();

      function animate() {
        ctx.fillStyle = '#090d16';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        let cardWidth = (canvas.width - 100) / 4;
        let cardHeight = 160;

        quizData.options.forEach((opt, idx) => {
          let cardX = 20 + idx * (cardWidth + 20);
          let cardY = (canvas.height - cardHeight) / 2;

          let isSelected = hoveredCard === idx;

          ctx.fillStyle = isSelected ? '#1e293b' : '#0f172a';
          ctx.beginPath();
          ctx.roundRect(cardX, cardY, cardWidth, cardHeight, 12);
          ctx.fill();

          ctx.strokeStyle = isSelected ? '#facc15' : '#334155';
          ctx.lineWidth = isSelected ? 4 : 2;
          ctx.stroke();

          // Suspect Icon
          ctx.fillStyle = isSelected ? '#facc15' : '#38bdf8';
          ctx.font = '36px "Font Awesome 6 Free"';
          ctx.fontStyle = '900';
          ctx.textAlign = 'center';
          ctx.fillText('🕵️', cardX + cardWidth / 2, cardY + 65);

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 14px "Jua", sans-serif';
          ctx.fillText(`용의자 ${idx + 1}`, cardX + cardWidth / 2, cardY + 115);
        });

        appState.gameCanvasAnimationId = requestAnimationFrame(animate);
      }

      canvas.onclick = (e) => {
        const rect = canvas.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        let cardWidth = (canvas.width - 100) / 4;

        for (let idx = 0; idx < quizData.options.length; idx++) {
          let cardX = 20 + idx * (cardWidth + 20);
          if (clickX >= cardX && clickX <= cardX + cardWidth) {
            playSfx('click');
            hoveredCard = idx;
            selectQuizOption(idx, document.getElementById('quiz-options-container').children[idx]);
            checkAnswerDirectly();
            break;
          }
        }
      };

      animate();
    }

    // 5. PROBABILITY ROULETTE GAME (REAL FRICTION SPIN)
    function runRouletteGame(canvas, ctx, quizData) {
      document.getElementById('game-hud-title').innerHTML = `<i class="fa-solid fa-dice text-yellow-400"></i> 확률 룰렛: 액션 버튼을 눌러 스핀을 시작하세요!`;

      let currentAngle = 0;
      let rotationSpeed = 0;
      let isSpinning = false;

      function updateControlsUI() {
        document.getElementById('btn-control-left').innerHTML = `<i class="fa-solid fa-rotate-left"></i> 저속 스핀`;
        document.getElementById('btn-control-right').innerHTML = `고속 스핀 <i class="fa-solid fa-rotate-right"></i>`;
        document.getElementById('btn-control-action').innerHTML = `<i class="fa-solid fa-play"></i> 룰렛 스핀!`;
      }
      updateControlsUI();

      function animate() {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        if (isSpinning) {
          currentAngle += rotationSpeed;
          rotationSpeed *= 0.985; // Natural Friction

          if (rotationSpeed < 0.002) {
            isSpinning = false;
            rotationSpeed = 0;

            // Calculate Winning Option Slot
            let normalizedAngle = (Math.PI * 2 - (currentAngle % (Math.PI * 2))) % (Math.PI * 2);
            let slice = (Math.PI * 2) / quizData.options.length;
            let winIdx = Math.floor(normalizedAngle / slice);

            selectQuizOption(winIdx, document.getElementById('quiz-options-container').children[winIdx]);
            checkAnswerDirectly();
          }
        }

        let centerX = canvas.width / 2;
        let centerY = canvas.height / 2;
        let radius = 105;

        ctx.save();
        ctx.translate(centerX, centerY);
        ctx.rotate(currentAngle);

        let slice = (Math.PI * 2) / quizData.options.length;
        quizData.options.forEach((_, idx) => {
          ctx.beginPath();
          ctx.fillStyle = idx % 2 === 0 ? '#facc15' : '#38bdf8';
          ctx.moveTo(0, 0);
          ctx.arc(0, 0, radius, idx * slice, (idx + 1) * slice);
          ctx.fill();

          ctx.fillStyle = '#0f172a';
          ctx.font = 'bold 15px "Jua", sans-serif';
          ctx.textAlign = 'center';
          let textAngle = idx * slice + slice / 2;
          ctx.fillText(`${idx + 1}`, Math.cos(textAngle) * (radius * 0.65), Math.sin(textAngle) * (radius * 0.65) + 5);
        });

        ctx.restore();

        // Top Pointer Pin
        ctx.fillStyle = '#f43f5e';
        ctx.beginPath();
        ctx.moveTo(centerX, centerY - radius - 5);
        ctx.lineTo(centerX - 12, centerY - radius - 25);
        ctx.lineTo(centerX + 12, centerY - radius - 25);
        ctx.fill();

        appState.gameCanvasAnimationId = requestAnimationFrame(animate);
      }

      document.getElementById('btn-control-action').onclick = () => {
        if (!isSpinning) {
          playSfx('click');
          rotationSpeed = 0.3 + Math.random() * 0.25;
          isSpinning = true;
        }
      };

      animate();
    }
  </script>
