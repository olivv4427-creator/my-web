    function checkAnswerDirectly() {
      if (appState.selectedOption === null) {
        showFeedback('제출할 답안 옵션을 선택해 주세요!', 'warning');
        return;
      }

      const qData = appState.currentQuizList[appState.currentQuizIdx];
      if (appState.selectedOption === qData.ans) {
        playSfx('correct');
        appState.streak += 1;
        let goldGain = appState.goldBoosterActive ? 200 : 100;
        let xpGain = 20 + (appState.streak * 5);

        if (appState.goldBoosterActive) {
          appState.goldBoosterActive = false;
        }

        showFeedback(`정답입니다! 🔥 ${appState.streak}연속 정답 (+${goldGain} 골드, +${xpGain} XP)`, 'success');
        addGoldAndXP(goldGain, xpGain);
        updateStreakHUD();

        setTimeout(() => {
          showGameOverlay(true, "퀘스트 성공!", `정답을 맞혀 +${goldGain} 골드와 +${xpGain} XP를 획득했습니다!`);
        }, 400);
      } else {
        playSfx('wrong');
        appState.streak = 0;
        updateStreakHUD();
        showFeedback('오답입니다! 문제를 차근차근 다시 풀어보세요.', 'error');
      }
    }

