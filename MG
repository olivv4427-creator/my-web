    function launchGameQuest(chapId, chapName, gameType) {
      appState.currentChapter = { id: chapId, name: chapName, gameType: gameType };
      appState.currentQuizList = quizDatabase[chapId] || quizDatabase["default"];
      appState.currentQuizIdx = 0;

      document.getElementById('view-chapter-select').classList.add('hidden');
      document.getElementById('view-game').classList.remove('hidden');

      const sub = curriculumData[appState.selectedSubjectIdx];
      document.getElementById('game-subject-name').innerText = `${sub.title}`;
      document.getElementById('game-chapter-name').innerText = `${chapName}`;

