      document.getElementById('game-rule-title').innerText = rule.title;
      document.getElementById('game-rule-desc').innerText = rule.shortDesc;
      document.getElementById('game-rule-icon').className = `fa-solid ${rule.icon}`;

      loadQuizProblem();
      initCanvasGame(gameType);

      window.scrollTo({ top: 0, behavior: 'smooth' });
