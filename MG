        btn.onclick = () => { playSfx('click'); selectQuizOption(idx, btn); };
        btn.innerHTML = `
          <span>${idx + 1}. ${optText}</span>
          <div class="w-5 h-5 rounded-full border-2 border-sky-300 flex items-center justify-center group-hover:border-sky-500 shrink-0 ml-2">
